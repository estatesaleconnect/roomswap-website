# ── Required ─────────────────────────────────────────────
# Your Anthropic API key (same one you use for the pricing tool)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ── Photo Source Folder ──────────────────────────────────
# Where to look for new photos. Default: ~/Dropbox/Camera Uploads
# Change this to wherever your photos sync to.
# Examples:
#   Windows Dropbox:  C:\Users\YourName\Dropbox\Camera Uploads
#   Mac Dropbox:      /Users/YourName/Dropbox/Camera Uploads
#   Google Drive:     C:\Users\YourName\Google Drive\Phone Photos
#   Any folder:       C:\Users\YourName\Desktop\gallery-photos
WATCH_FOLDER=

# ── Optional Settings ────────────────────────────────────
# Where processed originals are moved to (default: WATCH_FOLDER/_uploaded)
# PROCESSED_DIR=

# Path to your roomswap-website repo (default: auto-detected)
# REPO_ROOT=

# Max image width in pixels (default: 1600)
# MAX_WIDTH=1600

# JPEG quality 1-100 (default: 82, good balance of quality and file size)
# JPEG_QUALITY=82

# Auto-push to GitHub after each photo? (default: true)
# Set to false if you want to review commits before pushing.
# AUTO_PUSH=true
